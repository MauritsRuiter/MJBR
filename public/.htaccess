DirectoryIndex index.html

ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval' blob:; style-src * 'unsafe-inline' https://fonts.googleapis.com; img-src * data: blob:; worker-src 'self' blob:; frame-src 'self' blob:"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
